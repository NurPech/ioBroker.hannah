{
  "name": "iobroker.hannah",
  "version": "0.21.1",
  "description": "Connects ioBroker to Hannah voice assistant via bidirectional gRPC — streams device states, presence and commands in real time.",
  "author": {
    "name": "M1kad0",
    "email": "leonie+iobroker@sgessinger.de"
  },
  "contributors": [],
  "homepage": "https://github.com/NurPech/ioBroker.hannah",
  "license": "MIT",
  "keywords": [
    "hannah",
    "gRPC",
    "voice assistant",
    "ioBroker"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/NurPech/ioBroker.hannah.git"
  },
  "engines": {
    "node": ">= 22"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.4",
    "@grpc/proto-loader": "^0.8.1",
    "@iobroker/adapter-core": "^3.3.2",
    "@iobroker/dm-utils": "^3.0.19",
    "adm-zip": "^0.5.17"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.0",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/adapter-react-v5": "^8.2.7",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^5.2.2",
    "@m1kad0/esp-nvs-utils": "^0.2.1",
    "@mui/material": "^6.5.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/adm-zip": "^0.5.8",
    "@types/iobroker": "npm:@iobroker/types@^7.1.2",
    "@types/node": "^20.19.41",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "esptool-js": "^0.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "rimraf": "^6.1.3",
    "source-map-support": "^0.5.21",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "admin/build/**",
    "build/",
    "build/proto/",
    "www/",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "prebuild": "rimraf build admin/build",
    "build": "build-adapter all && node -e \"require('fs').mkdirSync('build/proto',{recursive:true});require('fs').copyFileSync('src/proto/hannah.proto','build/proto/hannah.proto')\"",
    "watch": "build-adapter all --watch",
    "prebuild:ts": "rimraf build",
    "build:ts": "build-adapter ts",
    "watch:ts": "build-adapter ts --watch",
    "prebuild:react": "rimraf admin/build",
    "build:react": "build-adapter react",
    "watch:react": "build-adapter react --watch",
    "test:ts": "mocha --config test/mocharc.custom.json src/**/*.test.ts",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:ts && npm run test:package",
    "check": "tsc --noEmit && tsc --noEmit -p admin/tsconfig.json",
    "lint": "eslint -c eslint.config.mjs .",
    "prepack": "npm run build",
    "verify:package": "node scripts/verify-package-contents.mjs",
    "translate": "translate-adapter",
    "release": "release-script",
    "dev-server": "dev-server"
  },
  "bugs": {
    "url": "https://github.com/NurPech/ioBroker.hannah/issues"
  },
  "readmeFilename": "README.md"
}
